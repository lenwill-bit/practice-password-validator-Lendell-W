const readlineSync = require('readline-sync');

let password;
let isValid = false;

do {
  password = readlineSync.question("Enter a password: ");

  let hasUppercase = false;
  let hasNumber = false;

  // Check each character in the password
  for (const char of password) {
    if (char >= "A" && char <= "Z") {
      hasUppercase = true;
    }
    if (char >= "0" && char <= "9") {
      hasNumber = true;
    }
  }

  // Check all three requirements together
  if (password.length >= 8 && hasUppercase && hasNumber) {
    isValid = true;
    console.log("Success! Your password meets all the requirements.");
  } else {
    console.log("Your password does not meet the requirements.");
    console.log("It must be at least 8 characters long and include one uppercase letter and one number.\n");
  }
} while (!isValid);